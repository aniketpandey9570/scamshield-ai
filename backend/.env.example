# ============================================================
# ScamShield AI - Backend Environment Configuration
# ============================================================

# Optional: Google Gemini API Key (e.g. AIzaSy...)
# If not provided, ScamShield AI automatically uses its built-in
# heuristic rule-based detection engine without requiring any key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Alternative OpenAI / Compatible API Key
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# CORS allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate limiting configuration (requests per window)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

